# Multi-arch Dockerfile for Dgraph debug image.
# Expects pre-built binaries in linux-arm64/ and linux-amd64/ directories.

FROM ubuntu:24.04
LABEL maintainer="Istari Digital, Inc. <dgraph-admin@istaridigital.com>"

ARG TARGETARCH

RUN rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    htop \
    curl \
    iputils-ping \
    jq \
    libjemalloc-dev \
    less \
    sysstat \
    gnupg \
    gnupg2 \
    tar \
    libpam0g \
    && rm -rf /var/lib/apt/lists/*

COPY linux-${TARGETARCH}/dgraph /usr/local/bin/dgraph

RUN mkdir /dgraph
WORKDIR /dgraph

ENV GODEBUG=madvdontneed=1
CMD ["dgraph"]
